/* CoraOS Plymouth Boot Script */

Window.SetBackgroundTopColor(0.04, 0.04, 0.04);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.02);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30);
logo.sprite.SetOpacity(1);

progress_box.image = Image("progress-bg.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.x = Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2;
progress_box.y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 20;
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

progress_bar.original_image = Image("progress-fill.png");
progress_bar.sprite = Sprite();
progress_bar.x = progress_box.x + 3;
progress_bar.y = progress_box.y + 3;
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);

fun progress_callback(duration, progress) {
    if (progress_bar.original_image) {
        new_width = progress_bar.original_image.GetWidth() * progress;
        if (new_width > 1) {
            progress_bar.image = progress_bar.original_image.Scale(new_width,
                progress_bar.original_image.GetHeight());
            progress_bar.sprite.SetImage(progress_bar.image);
        }
    }
}

/* Pulsing logo */
global.pulse = 0.7;
global.pulse_dir = 1;

fun refresh_callback() {
    global.pulse += global.pulse_dir * 0.008;
    if (global.pulse >= 1.0) global.pulse_dir = -1;
    if (global.pulse <= 0.5) global.pulse_dir = 1;
    logo.sprite.SetOpacity(global.pulse);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
