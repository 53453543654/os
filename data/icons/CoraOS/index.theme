[Icon Theme]
Name=CoraOS
Comment=CoraOS Icon Theme - Red accents on dark
Inherits=Adwaita,hicolor
Example=folder

Directories=scalable/actions,scalable/apps,scalable/devices,scalable/places,scalable/status,scalable/mimetypes

[scalable/actions]
Size=16
Context=Actions
Type=Scalable
MinSize=8
MaxSize=512

[scalable/apps]
